{
    "name": "react-anagram-animation",
    "version": "1.5.1",
    "author": "Scott Canoni",
    "description": "A React component to use CSS animations to swap letters in 2 words which are an anagram of each other.  The text is animated in position after calculating initial and final positions of each letter.",
    "license": "WTFPL",
    "keywords": [
        "anagram",
        "animation",
        "react",
        "text",
        "swap",
        "letters",
        "rearrange"
    ],
    "homepage": "https://scottcanoni.github.io/react-anagram-animation/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/scottcanoni/react-anagram-animation.git"
    },
    "bugs": {
        "url": "https://github.com/scottcanoni/react-anagram-animation/issues"
    },
    "private": false,
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "sideEffects": false,
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "start": "vite",
        "build-demo": "vite build --outDir demo-build",
        "preview": "vite preview --outDir demo-build",
        "build": "vite build --config vite.config.lib.js",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit"
    },
    "peerDependencies": {
        "react": "^17.0.0 || ^18.0.0 || >=19.0.0",
        "react-dom": "^17.0.0 || ^18.0.0 || >=19.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/react": "^19.3.0",
        "@vitejs/plugin-react": "^6.0.1",
        "eslint": "^9.39.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "globals": "^17.12.0",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "typescript": "^7.0.2",
        "vite": "^8.0.3"
    }
}
